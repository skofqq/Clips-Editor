/* Twitch Shorts Studio — Fluent Design (Windows 11) dark theme.

   Neutrals follow WinUI dark resources (see ui/theme/palette.py):
     base #202020 · control #2d2d2d / hover #323232 / pressed #272727
     stroke #363636 · strong stroke #8a8a8a · flyout #2c2c2c
     text #ffffff / secondary #c5c5c5 / tertiary #9d9d9d / disabled #5d5d5d
   Corner radius: 4px controls, 8px flyouts and cards.
   @ACCENT@ & co. are the Windows accent colour, filled in by ui.theme.stylesheet();
   @GLYPHS@ is a folder with chevrons and check marks in matching colours. */

QWidget {
    background-color: #202020;
    color: #ffffff;
    font-family: "Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 10pt;
    selection-background-color: @ACCENT@;
    selection-color: @ON_ACCENT@;
    outline: none;
}
QWidget:disabled { color: #5d5d5d; }

/* ---------------------------------------------------------------- window */
QMainWindow::separator { background: #1c1c1c; width: 4px; height: 4px; }
QMainWindow::separator:hover { background: @ACCENT@; }
QSplitter::handle { background: #1c1c1c; }
QSplitter::handle:hover { background: @ACCENT@; }

QMenuBar { background: #202020; padding: 2px 6px; }
QMenuBar::item { padding: 6px 10px; background: transparent; border-radius: 4px; color: #ffffff; }
QMenuBar::item:selected { background: #2d2d2d; }
QMenuBar::item:pressed { background: #272727; color: #c5c5c5; }

QMenu {
    background: #2c2c2c;
    border: 1px solid #3b3b3b;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item { padding: 7px 36px 7px 12px; border-radius: 4px; margin: 1px 0; background: transparent; }
QMenu::item:selected { background: #383838; }
QMenu::item:disabled { color: #5d5d5d; }
QMenu::separator { height: 1px; background: #3b3b3b; margin: 4px 0; }

/* Command bar at the top */
QToolBar#mainToolbar {
    background: #202020;
    border: none;
    padding: 4px 10px 8px 10px;
    spacing: 4px;
}
QToolBar#mainToolbar QLabel#appTitle { color: #ffffff; font-size: 10.5pt; font-weight: 600; padding: 0 8px 0 2px; }
QToolBar#mainToolbar QLabel#projectName { color: #9d9d9d; padding: 0 10px 0 4px; }
QToolBar#mainToolbar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 11px;
    color: #ffffff;
}
QToolBar#mainToolbar QToolButton:hover { background: #2d2d2d; }
QToolBar#mainToolbar QToolButton:pressed { background: #272727; color: #c5c5c5; }
QToolBar#mainToolbar QToolButton:disabled { color: #5d5d5d; }
QToolBar#mainToolbar QToolButton#youtubeAction {
    background: #2d2d2d; border: 1px solid #363636; border-bottom-color: #2a2a2a; padding: 6px 14px;
}
QToolBar#mainToolbar QToolButton#youtubeAction:hover { background: #323232; }
QToolBar#mainToolbar QToolButton#primaryAction {
    background: @ACCENT@;
    border: 1px solid @ACCENT_HOVER@;
    color: @ON_ACCENT@;
    font-weight: 600;
    padding: 6px 16px;
}
QToolBar#mainToolbar QToolButton#primaryAction:hover { background: @ACCENT_HOVER@; }
QToolBar#mainToolbar QToolButton#primaryAction:pressed { background: @ACCENT_PRESSED@; }
QToolBar#mainToolbar QToolButton#primaryAction:disabled { background: #2d2d2d; border-color: #2d2d2d; color: #5d5d5d; }
QToolBar#mainToolbar QFrame#toolbarSeparator { background: #3b3b3b; min-width: 1px; max-width: 1px; margin: 6px 6px; }

QDockWidget { color: #ffffff; font-weight: 600; }
QDockWidget::title {
    background: #202020;
    padding: 8px 12px 6px 12px;
    text-align: left;
}
QDockWidget::close-button, QDockWidget::float-button {
    background: transparent; border: none; border-radius: 4px; padding: 3px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background: #2d2d2d; }

QStatusBar { background: #202020; color: #9d9d9d; border-top: 1px solid #2f2f2f; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #9d9d9d; }

/* --------------------------------------------------------------- buttons */
QPushButton, QToolButton {
    background: #2d2d2d;
    border: 1px solid #363636;
    border-top-color: #3a3a3a;
    border-bottom-color: #2a2a2a;
    border-radius: 4px;
    padding: 5px 12px;
    color: #ffffff;
    min-height: 20px;
}
QToolButton { padding: 5px 8px; }
QPushButton:hover, QToolButton:hover { background: #323232; }
QPushButton:pressed, QToolButton:pressed { background: #272727; color: #c5c5c5; border-color: #303030; }
QPushButton:focus, QToolButton:focus { border-color: #8a8a8a; }
QPushButton:disabled, QToolButton:disabled { background: #262626; color: #5d5d5d; border-color: #2c2c2c; }
QPushButton:checked, QToolButton:checked {
    background: @ACCENT@; color: @ON_ACCENT@; border-color: @ACCENT_HOVER@;
}
QPushButton:checked:hover, QToolButton:checked:hover { background: @ACCENT_HOVER@; }
QPushButton#primary {
    background: @ACCENT@;
    border: 1px solid @ACCENT_HOVER@;
    color: @ON_ACCENT@;
    font-weight: 600;
}
QPushButton#primary:hover { background: @ACCENT_HOVER@; }
QPushButton#primary:pressed { background: @ACCENT_PRESSED@; }
QPushButton#primary:disabled { background: #2d2d2d; border-color: #2d2d2d; color: #5d5d5d; }

/* Media transport */
QPushButton#playButton {
    background: @ACCENT@;
    border: 1px solid @ACCENT_HOVER@;
    border-radius: 17px;
    min-width: 34px; max-width: 34px; min-height: 34px; max-height: 34px;
    padding: 0;
}
QPushButton#playButton:hover { background: @ACCENT_HOVER@; }
QPushButton#playButton:pressed { background: @ACCENT_PRESSED@; }
QPushButton#transportButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    min-width: 32px; max-width: 32px; min-height: 30px; max-height: 30px;
    padding: 0;
}
QPushButton#transportButton:hover { background: #2d2d2d; }
QPushButton#transportButton:pressed { background: #272727; }

/* Segmented control (Original / Both / Output) */
QWidget#segmented { background: #1c1c1c; border: 1px solid #2f2f2f; border-radius: 6px; }
QWidget#segmented QPushButton {
    background: transparent; border: 1px solid transparent; border-radius: 4px;
    padding: 4px 16px; color: #c5c5c5; min-height: 18px;
}
QWidget#segmented QPushButton:hover { background: #2a2a2a; color: #ffffff; }
QWidget#segmented QPushButton:checked {
    background: #2d2d2d; border: 1px solid #363636; color: #ffffff; font-weight: 600;
}

/* ---------------------------------------------------------------- inputs
   Fluent text boxes: control fill, hairline stroke, a stronger bottom line
   that turns into a 2px accent line while focused. */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateTimeEdit, QDateEdit, QTimeEdit {
    background: #2d2d2d;
    border: 1px solid #363636;
    border-bottom: 1px solid #8a8a8a;
    border-radius: 4px;
    padding: 4px 10px 4px 10px;
    min-height: 20px;
    color: #ffffff;
}
QLineEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QDateTimeEdit:hover { background: #323232; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateTimeEdit:focus {
    background: #1f1f1f;
    border-bottom: 2px solid @ACCENT@;
    padding-bottom: 3px;
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QDateTimeEdit:disabled {
    background: #262626; border-color: #2c2c2c; color: #5d5d5d;
}
QLineEdit[frame="false"] { border: none; background: transparent; padding: 3px 2px; }
QAbstractSpinBox QLineEdit, QComboBox QLineEdit {
    border: none; background: transparent; padding: 0; margin: 0; min-height: 0; border-radius: 0;
}

QSpinBox, QDoubleSpinBox, QDateTimeEdit { padding-right: 22px; }
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border; subcontrol-position: top right;
    width: 20px; border: none; border-top-right-radius: 4px; background: transparent; margin: 1px 1px 0 0;
}
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border; subcontrol-position: bottom right;
    width: 20px; border: none; border-bottom-right-radius: 4px; background: transparent; margin: 0 1px 1px 0;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover, QDateTimeEdit::up-button:hover, QDateTimeEdit::down-button:hover { background: #3a3a3a; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QDateTimeEdit::up-arrow { image: url("@GLYPHS@/chevron-up.svg"); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QDateTimeEdit::down-arrow { image: url("@GLYPHS@/chevron-down.svg"); width: 10px; height: 10px; }

QPlainTextEdit, QTextEdit {
    background: #2d2d2d;
    border: 1px solid #363636;
    border-bottom: 1px solid #8a8a8a;
    border-radius: 4px;
    padding: 4px 6px;
}
QPlainTextEdit:focus, QTextEdit:focus { background: #1f1f1f; border-bottom: 2px solid @ACCENT@; }
QPlainTextEdit:disabled, QTextEdit:disabled { background: #262626; border-color: #2c2c2c; }

/* Fluent combo boxes look like buttons with a chevron. */
QComboBox {
    background: #2d2d2d;
    border: 1px solid #363636;
    border-top-color: #3a3a3a;
    border-bottom-color: #2a2a2a;
    border-radius: 4px;
    padding: 4px 30px 4px 10px;
    min-height: 20px;
}
QComboBox:hover { background: #323232; }
QComboBox:on { background: #272727; }
QComboBox:focus { border-color: #8a8a8a; }
QComboBox:disabled { background: #262626; color: #5d5d5d; border-color: #2c2c2c; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: center right; width: 28px; border: none; }
QComboBox::down-arrow { image: url("@GLYPHS@/chevron-down.svg"); width: 12px; height: 12px; }
QComboBox::down-arrow:disabled { image: url("@GLYPHS@/chevron-down-disabled.svg"); }
QComboBox QAbstractItemView {
    background: #2c2c2c;
    border: 1px solid #3b3b3b;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #383838;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item { min-height: 30px; padding: 0 10px; border-radius: 4px; }
QComboBox QAbstractItemView::item:hover { background: #383838; }

QDateTimeEdit::drop-down { width: 22px; border: none; }
QCalendarWidget QWidget { alternate-background-color: #2c2c2c; }
QCalendarWidget QToolButton { background: transparent; border: none; }

QCheckBox, QRadioButton { spacing: 8px; background: transparent; min-height: 22px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 18px; height: 18px; border: 1px solid #8a8a8a; background: #1d1d1d;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { background: #2a2a2a; }
QCheckBox::indicator:checked, QCheckBox::indicator:indeterminate {
    background: @ACCENT@; border-color: @ACCENT@; image: url("@GLYPHS@/check.svg");
}
QCheckBox::indicator:checked:hover { background: @ACCENT_HOVER@; border-color: @ACCENT_HOVER@; }
QRadioButton::indicator:checked { background: @ACCENT@; border-color: @ACCENT@; image: url("@GLYPHS@/dot.svg"); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background: #262626; border-color: #3b3b3b; }
QCheckBox::indicator:checked:disabled { background: #3b3b3b; border-color: #3b3b3b; }

/* ---------------------------------------------------------- collections */
QListWidget, QTreeWidget, QTableWidget, QTableView, QTreeView, QListView {
    background: #1c1c1c;
    border: 1px solid #2f2f2f;
    border-radius: 8px;
    padding: 3px;
    alternate-background-color: #222222;
}
QListWidget::item, QTreeWidget::item, QListView::item, QTreeView::item {
    padding: 6px 8px;
    border-radius: 4px;
    border-left: 3px solid transparent;
    margin: 1px 0;
}
QListWidget::item:hover, QTreeWidget::item:hover, QListView::item:hover, QTreeView::item:hover { background: #2a2a2a; }
QListWidget::item:selected, QTreeWidget::item:selected, QListView::item:selected, QTreeView::item:selected {
    background: #2d2d2d; color: #ffffff; border-left: 3px solid @ACCENT@;
}
QTableWidget::item, QTableView::item { padding: 4px 6px; }
QTableWidget::item:selected, QTableView::item:selected { background: #2d2d2d; color: #ffffff; }
QTableWidget, QTableView { gridline-color: #2a2a2a; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background: #1c1c1c;
    border: none;
    border-bottom: 1px solid #2f2f2f;
    padding: 6px 8px;
    color: #c5c5c5;
    font-weight: 600;
}
QTableCornerButton::section { background: #1c1c1c; border: none; }

QGroupBox {
    background: #272727;
    border: 1px solid #1d1d1d;
    border-radius: 8px;
    margin-top: 16px;
    padding: 12px 10px 10px 10px;
}
QGroupBox::title { subcontrol-origin: margin; left: 4px; padding: 0 4px; color: #ffffff; font-weight: 600; }

QProgressBar {
    background: #3a3a3a; border: none; border-radius: 2px; text-align: center; color: transparent;
    min-height: 4px; max-height: 4px;
}
QProgressBar::chunk { border-radius: 2px; background: @ACCENT@; }

/* Fluent slider: thin track, accent fill, round thumb with an accent core.
   The look stays slim, but the widget is 36px tall and a click anywhere on
   that height jumps the thumb there (ui/widgets/jump_slider.py). */
QSlider { background: transparent; min-height: 36px; }
QSlider::groove:horizontal { height: 4px; background: #9a9a9a; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @ACCENT@; border-radius: 2px; }
QSlider::add-page:horizontal { background: #6a6a6a; border-radius: 2px; }
QSlider::handle:horizontal {
    background: @ACCENT@;
    border: 5px solid #454545;
    width: 10px;
    height: 10px;
    margin: -8px 0;
    border-radius: 10px;
}
QSlider::handle:horizontal:hover { border-width: 4px; width: 12px; height: 12px; margin: -8px 0; }
QSlider::handle:horizontal:disabled { background: #5d5d5d; }

QScrollBar:vertical { background: transparent; width: 12px; margin: 2px 2px 2px 0; }
QScrollBar::handle:vertical { background: #5d5d5d; border-radius: 3px; min-height: 30px; margin: 0 3px; }
QScrollBar::handle:vertical:hover { background: #9d9d9d; margin: 0 2px; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 0 2px 2px 2px; }
QScrollBar::handle:horizontal { background: #5d5d5d; border-radius: 3px; min-width: 30px; margin: 3px 0; }
QScrollBar::handle:horizontal:hover { background: #9d9d9d; margin: 2px 0; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QScrollArea { border: none; background: transparent; }

/* ------------------------------------------------------------------ tabs
   Pivot-style: secondary text, the selected tab in primary text with an
   accent bar under it. */
QTabWidget::pane { border: none; top: -1px; }
QTabBar { background: transparent; qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent;
    padding: 7px 12px 6px 12px;
    margin: 2px 2px 0 2px;
    color: #c5c5c5;
    border: none;
    border-bottom: 3px solid transparent;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:hover { color: #ffffff; background: #2a2a2a; }
QTabBar::tab:selected { color: #ffffff; font-weight: 600; border-bottom: 3px solid @ACCENT@; }
QTabBar::close-button { subcontrol-position: right; }

/* --------------------------------------------------------------- labels */
QLabel { background: transparent; }
QLabel#sectionTitle { color: #ffffff; font-weight: 600; padding-top: 10px; }
QLabel#muted { color: #9d9d9d; }
QLabel#timecode { font-family: "Cascadia Mono", Consolas, "DejaVu Sans Mono", monospace; color: #ffffff; }
QLabel#badge {
    background: #2d2d2d; color: @ACCENT_TEXT@; border: 1px solid #363636; border-radius: 4px;
    padding: 1px 8px; font-size: 9pt; font-weight: 600;
}

QToolTip {
    background: #2c2c2c;
    color: #ffffff;
    border: 1px solid #3b3b3b;
    padding: 5px 8px;
}

QDialog { background: #202020; }
QMessageBox { background: #2b2b2b; }
QMessageBox QLabel { color: #ffffff; }
QDialogButtonBox QPushButton { min-width: 90px; }

/* ---- cards and empty states ---- */
QFrame#card {
    background: #252525;
    border: 1px solid #1d1d1d;
    border-radius: 8px;
}
QFrame#card QLabel { background: transparent; }
QFrame#card QPushButton:!checked:!disabled { border-color: #3d3d3d; border-top-color: #444444; }
QFrame#card QPushButton#primary:!disabled { border-color: @ACCENT_HOVER@; }
QLabel#cardTitle { color: #ffffff; font-weight: 600; font-size: 14px; padding-bottom: 2px; }
QLabel#emptyTitle { color: #ffffff; font-weight: 600; font-size: 15px; }
QListWidget#mediaList { background: transparent; border: none; }
QListWidget#mediaList::item { border: none; background: transparent; }
QToolButton#cardToggle {
    background: transparent; border: none; color: #ffffff; font-weight: 600; padding: 2px 0;
}
QToolButton#cardToggle:hover { color: @ACCENT_TEXT@; }
QToolButton#cardToggle:checked { background: transparent; color: #ffffff; }
